NODE_ENV=development

# Service
SERVICE_NAME=procurement-inventory-service
SERVICE_PORT=4040

# Database - MySQL
DB_TYPE=mysql
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=structura_user
DB_PASSWORD=structura_pass123
DB_NAME=procurement_inventory

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis123

# RabbitMQ
RABBITMQ_URL=amqp://rabbitmq:5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION=24h

# API Gateway
API_GATEWAY_URL=http://localhost:80

# AWS LocalStack
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
LOCALSTACK_ENDPOINT=http://localstack:4566
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:structura-notifications

# Logging
LOG_LEVEL=debug
